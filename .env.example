# ========================================================
# SAFİRYA ATÖLYE - ÖRNEK ÇEVRE DEĞİŞKENLERİ (.env.example)
# ========================================================

# 1. VERİTABANI BAĞLANTISI (PostgreSQL / Supabase)
# Supabase Dashboard -> Project Settings -> Database -> Connection String
# Pooling URL (Session / Transaction mode, Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL (Port 5432 - Prisma migration & studio için)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. UYGULAMA ADRESİ
NEXT_PUBLIC_APP_URL="https://safirya.tr"

# 3. YÖNETİM PANELİ (ERP) ŞİFRELİ GİRİŞ VE GÜVENLİK
ADMIN_USERNAME="admin@safirya.tr"
ADMIN_PASSWORD="GucluSifreniz2026!"
ADMIN_JWT_SECRET="guclu_ve_uzun_rastgele_bir_jwt_anahtari_en_az_32_karakter"

# 4. CLOUDINARY GÖRSEL VE MEDYA YÖNETİMİ
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# 5. SUPABASE PROJESİ & DEPOLAMA
# https://supabase.com/dashboard/project/[PROJECT_REF]/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 6. E-POSTA VE BİLDİRİM (Resend & SMTP)
RESEND_API_KEY="re_..."
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_..."
SMTP_FROM="Safirya Atölyesi <destek@safirya.tr>"

# 7. PAYTR SANAL POS & 3D SECURE ÖDEME ALTYAPISI
# PayTR Mağaza Paneli -> Bilgi menüsünden alınır: https://www.paytr.com/magaza/bilgi
PAYTR_MERCHANT_ID="your_merchant_id"
PAYTR_MERCHANT_KEY="your_merchant_key"
PAYTR_MERCHANT_SALT="your_merchant_salt"
PAYTR_TEST_MODE="1" # 1 = Test Modu, 0 = Canlı POS
PAYTR_DEBUG_ON="1" # 1 = Hata logları açık, 0 = kapalı
